cdn.freshdesk.com/data/helpdesk/attachments/production/155047058733/original/OR_pA9yGb_fxDpe2m__xVYz2QrBEOehHUAcfc2.png?1747908378", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155049109731/original/s7VjqPya3_-Wzil5lmwSkiL_lIWNDfBDgw7852.png?1751310313", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058838/original/CmNzBLCF5xbg54uSl9YVMGnGPDB0LaCZag3fe9.png?1747908485", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058859/original/gQNPWUqAnR5bPf9f3qHYxLusbAUmM8YUWA81fd.png?1747908517", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058915/original/gjZULfsoF-OYwAnKJmUeR5nwRTsbaDxT2Aa09a.png?1747908552", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059020/original/kAQ2xKZZ_bKVGYwLxOwWmCkg-iiPTPLhBw25ea.png?1747908640", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059109/original/9QU1br6MPBiCacMpYymg61zIwLd1OkFtawa891.png?1747908700", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059305/original/XBGT2gOmYFkq0pOwC_zcfIWkRaDTPS0Cwg7067.png?1747908822", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059464/original/MGY7wLnUPLSSEDR4iqmjgsQ25YlZiOu26wd3a5.png?1747908918", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059731/original/XldF812XQvfXCn5vEag7_YE6UJ_x7T0GsA7727.png?1747909131", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059558/original/XzlpBGzBjYe6lI-QFSNPW_XhQlpi0ARjpAcc6c.png?1747908993"], "videos": [], "content": "\n\t\t<p class=\"fd-toc\"><strong>TABLE OF CONTENTS</strong></p><p><br></p><ul><li><a href=\"#Introduction%C2%A0\">Introduction&nbsp;</a></li><li><a href=\"#Why-Use-This?\">Why Use This?</a></li><li><a href=\"#Step-by-Step-Guide-to-Using-the-Guided-Form-Bot\">Step-by-Step Guide to Using the Guided Form Bot</a><ul><li><a href=\"#Step-1%3A-Go-to-the-Create-Bot-Page\">Step 1: Go to the Create Bot Page</a></li><li><a href=\"#Step-2%3A-Input-Brand-Information-(Optional)\">Step 2: Input Brand Information (Optional)</a></li><li><a href=\"#Step-3%3A-Configure-Basic-Bot-Settings\">Step 3: Configure Basic Bot Settings</a></li><li><a href=\"#Step-4%3A-Define-Objectives-and-Questions\">Step 4: Define Objectives and Questions</a></li><li><a href=\"#Step-6%3A-Action-Setup%C2%A0\">Step 6: Action Setup&nbsp;</a></li><li><a href=\"#Step-5%3A-Final-Review-and-Additional-Settings\">Step 5: Final Review and Additional Settings</a></li></ul></li><li><a href=\"#Summary\">Summary</a></li></ul><h2 dir=\"ltr\" id=\"Introduction&nbsp;\">Introduction&nbsp;</h2><p dir=\"ltr\"><br></p><p dir=\"ltr\">Welcome to our new Guided form based setup&nbsp;</p><p dir=\"ltr\"><br></p><ul><li data-end=\"280\" data-start=\"96\" dir=\"ltr\"><strong data-end=\"135\" data-start=\"96\">Guided Form Bot for Conversation AI</strong><br data-start=\"135\" data-end=\"138\">Introducing our latest innovation in Conversation AI\u2014a Guided Form Bot that makes bot setup faster, easier, and more precise than ever before! The Guided Form Bot is a new setup experience within Conversation AI that helps you build intelligent bots quickly and accurately\u2014without needing to write complex prompts. &nbsp;</li></ul><p data-end=\"280\" data-start=\"96\" dir=\"ltr\"><br></p><ul><li data-end=\"454\" data-start=\"282\"><strong data-end=\"317\" data-start=\"282\">Quick Setup in Under 3 Minutes:</strong><br data-start=\"317\" data-end=\"320\">Forget complex prompts. Just define what you want to achieve using simple objectives or questions, and the bot takes care of the rest.</li></ul><p data-end=\"454\" data-start=\"282\"><br></p><ul><li data-end=\"640\" data-start=\"456\"><strong data-end=\"482\" data-start=\"456\">No Prompting Required:</strong><br data-start=\"482\" data-end=\"485\">This bot eliminates the need for large or complex instructions. It strictly follows your defined goals, delivering reliable, on-point responses every time.</li></ul><p data-end=\"640\" data-start=\"456\"><br></p><ul><li data-end=\"778\" data-start=\"642\" dir=\"ltr\"><strong data-end=\"668\" data-start=\"642\" dir=\"ltr\">Effortless Automation:</strong><br data-start=\"668\" data-end=\"671\">Launch smart, task-driven bots in minutes\u2014ideal for lead capture, qualification, data collection, and more.</li></ul><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\">Activate this feature to create high-performing bots with minimal effort\u2014no prompting expertise required.</p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><h2 data-end=\"897\" data-start=\"881\" id=\"Why-Use-This?\"><span style=\"font-size: 16px;\"><strong>Why Use This?</strong></span></h2><p data-end=\"1124\" data-start=\"899\" dir=\"ltr\">Creating bots using prompts can often be time-consuming or inconsistent\u2014especially if you're not familiar with prompt engineering. The Guided Form Bot solves this by giving you a structured, no-prompt approach to building bots.</p><p data-end=\"1296\" data-start=\"1126\">Let\u2019s say you\u2019re a business owner who wants to capture lead details like name, email, phone number, and the service a customer is interested in. With this setup, you can:</p><ul data-end=\"1463\" data-start=\"1298\"><li data-end=\"1352\" data-start=\"1298\"><p data-end=\"1352\" data-start=\"1300\">Build bots without needing to write a single prompt.</p></li><li data-end=\"1391\" data-start=\"1353\"><p data-end=\"1391\" data-start=\"1355\">Define your goals in plain language.</p></li><li data-end=\"1463\" data-start=\"1392\"><p data-end=\"1463\" data-start=\"1394\">Trust the system to handle logic, flow, and follow-ups automatically.</p></li></ul><p data-end=\"1488\" data-start=\"1465\">This approach leads to:</p><ul data-end=\"1602\" data-start=\"1490\"><li data-end=\"1528\" data-start=\"1490\"><p data-end=\"1528\" data-start=\"1492\">Faster setup times (under 3 minutes)</p></li><li data-end=\"1568\" data-start=\"1529\"><p data-end=\"1568\" data-start=\"1531\">Consistent and reliable conversations</p></li><li data-end=\"1602\" data-start=\"1569\"><p data-end=\"1602\" data-start=\"1571\" dir=\"ltr\">No need for AI prompt expertise</p></li></ul><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><strong>This feature is currently enabled via labs&nbsp;</strong></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047085563/original/UwG9q7nQzhvAhAX8qLDKrjuCozroY9wMNw710d.png?1747927841\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155047085563\"></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><h2 data-end=\"1659\" data-start=\"1609\" id=\"Step-by-Step-Guide-to-Using-the-Guided-Form-Bot\"><strong>Step-by-Step Guide to Using the Guided Form Bot</strong></h2><h3 data-end=\"1700\" data-start=\"1661\" id=\"Step-1:-Go-to-the-Create-Bot-Page\"><strong>Step 1: Go to the Create Bot Page</strong></h3><p data-end=\"1791\" data-start=\"1701\">Navigate to the <strong data-end=\"1743\" data-start=\"1717\">Conversation AI &gt; Bots</strong> section and click on the <strong data-end=\"1783\" data-start=\"1769\">Create Bot</strong> button.</p><p data-end=\"1862\" data-start=\"1793\">By default, you will be taken through the <strong data-end=\"1850\" data-start=\"1835\">Guided Form</strong> setup flow.</p><p data-end=\"1862\" data-start=\"1793\"><br></p><p data-end=\"1862\" data-start=\"1793\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058740/original/RlZeVxiIIAUA-nZ_Yz_cycnbPBeLVegAWgec0b.png?1747908390\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047058740\"></p><p data-end=\"1862\" data-start=\"1793\"><br></p><p data-end=\"1862\" data-start=\"1793\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058608/original/ZwCnd-KvckinyB-zV9H_dkNQt1ldFNpyIg82de.png?1747908313\" style=\"width: 707px; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-attachment=\"[object Object]\" data-id=\"155047058608\"></p><p data-end=\"1862\" data-start=\"1793\"><br></p><blockquote data-end=\"1991\" data-start=\"1864\"><p data-end=\"1991\" data-start=\"1866\">If you prefer the traditional prompt-based setup, click the dropdown icon on the \"Create Bot\" button and switch to that mode.</p></blockquote><hr data-start=\"1993\" data-end=\"1996\"><h3 data-end=\"2046\" data-start=\"1998\" id=\"\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058733/original/OR_pA9yGb_fxDpe2m__xVYz2QrBEOehHUAcfc2.png?1747908378\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047058733\"></h3><p><br></p><h3 data-end=\"2046\" data-start=\"1998\" dir=\"ltr\" id=\"-1\"><br></h3><h3 data-end=\"2046\" data-start=\"1998\" dir=\"ltr\" id=\"Step-2:-Input-Brand-Information-(Optional)\"><strong>Step 2: Input Brand Information (Optional)</strong></h3><p data-end=\"2095\" data-start=\"2047\">This is an optional step but highly recommended.</p><p data-end=\"2185\" data-start=\"2097\">You can input basic brand information like your business name, type, tone of voice, etc.</p><p data-end=\"2329\" data-start=\"2187\">If you fill in the complete brand profile, the bot will generate more accurate and tone-aligned responses, enhancing your customer experience.</p><p data-end=\"2429\" data-start=\"2331\">However, if you want to proceed quickly, you can skip this and still build a fully functional bot.</p><p data-end=\"2429\" data-start=\"2331\"><br></p><p data-end=\"2429\" data-start=\"2331\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155049109731/original/s7VjqPya3_-Wzil5lmwSkiL_lIWNDfBDgw7852.png?1751310313\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155049109731\"></p><p data-end=\"2429\" data-start=\"2331\"><br></p><p data-end=\"2429\" data-start=\"2331\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058838/original/CmNzBLCF5xbg54uSl9YVMGnGPDB0LaCZag3fe9.png?1747908485\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047058838\"></p><p data-end=\"2429\" data-start=\"2331\"><br></p><p data-end=\"2429\" data-start=\"2331\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058859/original/gQNPWUqAnR5bPf9f3qHYxLusbAUmM8YUWA81fd.png?1747908517\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-attachment=\"[object Object]\" data-id=\"155047058859\"></p><p data-end=\"2429\" data-start=\"2331\"><br></p><p data-end=\"2429\" data-start=\"2331\" dir=\"ltr\">This section is strictly optional&nbsp;</p><p data-end=\"2429\" data-start=\"2331\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047058915/original/gjZULfsoF-OYwAnKJmUeR5nwRTsbaDxT2Aa09a.png?1747908552\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-attachment=\"[object Object]\" data-id=\"155047058915\"></p><hr data-start=\"2431\" data-end=\"2434\"><h3 data-end=\"2478\" data-start=\"2436\" id=\"Step-3:-Configure-Basic-Bot-Settings\"><strong>Step 3: Configure Basic Bot Settings</strong></h3><p data-end=\"2536\" data-start=\"2479\">This section mirrors the setup used in prompt-based bots.</p><p data-end=\"2546\" data-start=\"2538\">You can:</p><ul data-end=\"2717\" data-start=\"2548\"><li data-end=\"2644\" data-start=\"2548\"><p data-end=\"2644\" data-start=\"2550\">Set an <strong data-end=\"2576\" data-start=\"2557\">Initial Message</strong> that will always be sent when the bot interacts with a new contact.</p></li><li data-end=\"2717\" data-start=\"2645\"><p data-end=\"2717\" data-start=\"2647\">Configure basic properties like language, bot name, and behavior type.</p></li></ul><p data-end=\"2815\" data-start=\"2719\">This message sets the tone for the entire conversation and is shown before the objectives begin.</p><p data-end=\"2815\" data-start=\"2719\"><br></p><p data-end=\"2815\" data-start=\"2719\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059020/original/kAQ2xKZZ_bKVGYwLxOwWmCkg-iiPTPLhBw25ea.png?1747908640\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047059020\"></p><hr data-start=\"2817\" data-end=\"2820\"><h3 data-end=\"2867\" data-start=\"2822\" id=\"Step-4:-Define-Objectives-and-Questions\"><strong>Step 4: Define Objectives and Questions</strong></h3><p data-end=\"2914\" data-start=\"2868\">This is the core of the Guided Form Bot setup.</p><p data-end=\"2994\" data-start=\"2916\">Use this step to define what your bot should achieve. These can be goals like:</p><ul data-end=\"3137\" data-start=\"2996\"><li data-end=\"3010\" data-start=\"2996\"><p data-end=\"3010\" data-start=\"2998\">Collect name</p></li><li data-end=\"3034\" data-start=\"3011\"><p data-end=\"3034\" data-start=\"3013\">Ask for email address</p></li><li data-end=\"3053\" data-start=\"3035\"><p data-end=\"3053\" data-start=\"3037\">Get phone number</p></li><li data-end=\"3095\" data-start=\"3054\"><p data-end=\"3095\" data-start=\"3056\">Capture the customer\u2019s business website</p></li><li data-end=\"3137\" data-start=\"3096\"><p data-end=\"3137\" data-start=\"3098\">Understand the customer\u2019s current issue</p></li></ul><p><br></p><p data-end=\"3137\" data-start=\"3098\" dir=\"ltr\">if any of these information is present and you dont want to collect again , you can turn on the toggle - skip if already filled</p><p><br></p><p><br></p><p data-end=\"3137\" data-start=\"3098\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059109/original/9QU1br6MPBiCacMpYymg61zIwLd1OkFtawa891.png?1747908700\" class=\"fr-fil fr-dib fr-bordered\" style=\"box-sizing: content-box; border: 1px solid rgb(204, 204, 204); max-width: 100%; cursor: pointer; padding: 0px 1px; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; color: rgb(0, 0, 0); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif; font-size: 13px; font-weight: 400; text-indent: 0px; width: auto;\" data-attachment=\"[object Object]\" data-id=\"155047059109\"></p><p><br></p><p data-end=\"3211\" data-start=\"3139\">You can write each of these as simple one-line objectives. The bot will:</p><ul data-end=\"3333\" data-start=\"3213\"><li data-end=\"3254\" data-start=\"3213\"><p data-end=\"3254\" data-start=\"3215\">Follow the sequence exactly as defined.</p></li><li data-end=\"3292\" data-start=\"3255\"><p data-end=\"3292\" data-start=\"3257\">Never skip or ignore any objective.</p></li><li data-end=\"3333\" data-start=\"3293\"><p data-end=\"3333\" data-start=\"3295\">Prompt users clearly and consistently.</p></li></ul><p data-end=\"3430\" data-start=\"3335\">You can <strong data-end=\"3368\" data-start=\"3343\">reorder the questions</strong> anytime by dragging and dropping them using the reorder icon.</p><p data-end=\"3430\" data-start=\"3335\"><br></p><p data-end=\"3430\" data-start=\"3335\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059305/original/XBGT2gOmYFkq0pOwC_zcfIWkRaDTPS0Cwg7067.png?1747908822\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047059305\"></p><p data-end=\"3430\" data-start=\"3335\"><br></p><p data-end=\"3430\" data-start=\"3335\" dir=\"ltr\">If you want to collect more information you can do so by clicking the icon - Add Question / Objective. &nbsp;</p><p data-end=\"3430\" data-start=\"3335\" dir=\"ltr\">Ex - what is the issue you are facing</p><p data-end=\"3430\" data-start=\"3335\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059464/original/MGY7wLnUPLSSEDR4iqmjgsQ25YlZiOu26wd3a5.png?1747908918\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047059464\"></p><p data-end=\"3430\" data-start=\"3335\" dir=\"ltr\"><br></p><h3 data-end=\"3487\" data-start=\"3437\" dir=\"ltr\" id=\"Step-6:-Action-Setup&nbsp;\">Step 6: Action Setup&nbsp;</h3><p dir=\"ltr\">1. To book an Appointment select the Calendar.&nbsp;</p><p dir=\"ltr\">2. To trigger a workflow post appointment booking , trigger this workflow.&nbsp;</p><p dir=\"ltr\"><strong>3. The remaining actions will soon be released for this version&nbsp;</strong></p><p dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059731/original/XldF812XQvfXCn5vEag7_YE6UJ_x7T0GsA7727.png?1747909131\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047059731\"></p><hr data-start=\"3432\" data-end=\"3435\"><h3 data-end=\"3487\" data-start=\"3437\" dir=\"ltr\" id=\"Step-5:-Final-Review-and-Additional-Settings\">Step 5: Final Review and Additional Settings</h3><p data-end=\"3547\" data-start=\"3488\">Once your objectives are set, your bot is ready to go live.</p><p data-end=\"3557\" data-start=\"3549\">You can:</p><ul data-end=\"3735\" data-start=\"3559\"><li data-end=\"3637\" data-start=\"3559\"><p data-end=\"3637\" data-start=\"3561\">Click <strong data-end=\"3579\" data-start=\"3567\">Edit Bot</strong> to reconfigure brand details, bot settings, or questions.</p></li><li data-end=\"3735\" data-start=\"3638\"><p data-end=\"3735\" data-start=\"3640\">Add <strong data-end=\"3671\" data-start=\"3644\">Additional Instructions</strong>\u2014a short prompt to give the bot more specific context if needed.</p></li></ul><p data-end=\"3836\" data-start=\"3737\">This allows advanced users to fine-tune behavior without losing the simplicity of the guided setup.</p><p data-end=\"3836\" data-start=\"3737\"><br></p><p data-end=\"3836\" data-start=\"3737\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155047059558/original/XzlpBGzBjYe6lI-QFSNPW_XhQlpi0ARjpAcc6c.png?1747908993\" style=\"width: auto; max-width: 100%;\" class=\"fr-fil fr-dib fr-bordered\" data-id=\"155047059558\"></p><hr data-start=\"3838\" data-end=\"3841\"><h2 data-end=\"3855\" data-start=\"3843\" id=\"Summary\">Summary</h2><p data-end=\"3995\" data-start=\"3856\">The Guided Form Bot makes building AI bots accessible to everyone. Whether you're a marketer, business owner, or support lead, you can now:</p><ul data-end=\"4130\" data-start=\"3997\"><li data-end=\"4033\" data-start=\"3997\"><p data-end=\"4033\" data-start=\"3999\">Build bots without writing prompts</p></li><li data-end=\"4087\" data-start=\"4034\"><p data-end=\"4087\" data-start=\"4036\" dir=\"ltr\">Focus on what the bot should do, not how it does it</p></li><li data-end=\"4130\" data-start=\"4088\"><p data-end=\"4130\" data-start=\"4090\" dir=\"ltr\">Launch powerful conversations in minutes</p></li></ul><p data-end=\"4174\" data-start=\"4132\" dir=\"ltr\">No complexity. No guesswork. Just results</p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p><p data-end=\"885\" data-start=\"780\" dir=\"ltr\"><br></p>\n\t"}, {"slug": "155000006852-rearrange-elements-and-layouts-with-arrow-controls-in-email-builder", "title": "Rearrange Elements and Layouts with Arrow Controls in Email Builder", "folder": "Email Builder Capabilities", "images": ["../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057345621/original/0FCLz3v_kp6BD3L7JRZceT7ECpHRZVctxA27a9.png?1761937733"], "videos": [], "content": "\n\t\t<p><span class=\"fr-view collab-annotatable\" data-test-id=\"article-description\" style=\"box-sizing: border-box; overflow-wrap: break-word; color: rgb(24, 50, 71); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-size: 13px; font-weight: 400; text-align: start; text-indent: 0px; display: block; cursor: auto;\"></span></p><p dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 12pt; margin-left: 0px; font-size: 13px; line-height: 1.38; word-break: normal; overflow-wrap: break-word;\"><span dir=\"ltr\" style=\"box-sizing: border-box; font-size: 11pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\">This article shows you how to quickly rearrange elements and layouts in the Email Builder using new arrow controls. This feature makes editing emails faster, easier, and more intuitive by removing the need for complex drag-and-drop actions.</span></p><p class=\"fd-toc\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-