DEJ0UCga7dwbhamrSSjyfhRgjwYkxw3963.png?1763571484", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781031/original/E3zm-AUtjS4Om74CEBx_4Tl8ftB1M08Lww6db1.png?1763571509", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781106/original/3d-Lmziw9E7phUyVJ07fDIEVY2w8pkVHhw4a6c.png?1763571639", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781064/original/v0RncFUA5M7gXEnNVKvSrBhX-XPZINHP3Q2f03.png?1763571559", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781203/original/eK2-YVkDqsVEjJLEj9bQUevvdrq79isNXg3d9b.png?1763571751", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781303/original/WjPGO7euXUM9DieNoBYUZyfJZUod2HNgVg3a00.jpg?1763571890", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781312/original/DYY7u6GElLKYlQz6gDLUBd3quPIp6QsqvA7ee3.jpg?1763571903", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781288/original/plZ4NoT8BX_eIfl0ziRwezksHnwkGViEege13b.jpg?1763571874", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781334/original/0VYhcjR9S_nNnANt4pERccNQsUqys31Sqg74cb.jpg?1763571918", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781421/original/i3ooQZ67N0uDjNvKHlV0K2-bAhMXm4pZLA144e.png?1763572014", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781512/original/wSipxByD6Vb7ZvnPDhUJfi046MFnyBA0bA186c.png?1763572085"], "videos": [], "content": "\n\t\t<p data-end=\"610\" data-start=\"311\" dir=\"ltr\">Sending Gift Cards is a powerful feature that allows businesses to <strong data-end=\"463\" data-start=\"378\" dir=\"ltr\">issue gift cards directly to any customer\u2014without requiring a purchase or payment.</strong></p><p data-end=\"610\" data-start=\"311\" dir=\"ltr\"><br></p><p data-end=\"610\" data-start=\"311\" dir=\"ltr\">This is perfect for loyalty rewards, customer satisfaction gestures, refunds, promotions, internal testing, or manually granting prepaid credit. The Send flow works exclusively in <strong data-end=\"660\" data-start=\"647\" dir=\"ltr\">Live Mode&nbsp;</strong>currently, ensuring only real, fully functional gift cards are delivered.</p><hr data-start=\"726\" data-end=\"729\"><p class=\"fd-toc\"><strong>TABLE OF CONTENTS</strong></p><ul><li><a href=\"#Overview\">Overview</a></li><li><a dir=\"ltr\" href=\"#Use-Cases-for-Sending-Gift-Cards\">Use Cases for Sending Gift Cards</a><ul><ul><li><a dir=\"ltr\" href=\"#%E2%AD%90-Loyalty-&amp;-Rewards\">Loyalty &amp; Rewards</a></li><li><a dir=\"ltr\" href=\"#%E2%AD%90-Customer-Support-Compensation\">Customer Support Compensation</a></li><li><a dir=\"ltr\" href=\"#%E2%AD%90-Promotions\">Promotions</a></li><li><a dir=\"ltr\" href=\"#%E2%AD%90-Internal-Testing\">Internal Testing</a></li><li><a dir=\"ltr\" href=\"#%E2%AD%90-Bulk-Manual-Distribution\">Bulk Manual Distribution</a></li></ul></ul></li><li><a href=\"#Prerequisites\">Prerequisites</a></li><li><a href=\"#How-to-Send-a-Gift-Card-(Step-by-Step-Guide)\">How to Send a Gift Card (Step-by-Step Guide)</a><ul><ul><li><a href=\"#Step-1%3A-Navigate-to-Gift-Card-Products\">Step 1: Navigate to Gift Card Products</a></li><li><a href=\"#Step-2%3A%C2%A0Click-%E2%80%9CSend%E2%80%9D\">Step 2:&nbsp;Click \u201cSend\u201d</a></li><li><a href=\"#Step-3%3A%C2%A0Choose-a-Customer\">Step 3:&nbsp;Choose a Customer</a></li><li><a href=\"#Step-4%3A-Add-a-Personal-Message\">Step 4: Add a Personal Message</a></li><li><a href=\"#Step-5%3A-Select-a-Denomination\">Step 5: Select a Denomination</a></li><li><a href=\"#Step-6%3A-Choose-Delivery-Method\">Step 6: Choose Delivery Method</a></li><li><a href=\"#Step-7%3A-Choose-Delivery-Time\">Step 7: Choose Delivery Time</a></li><li><a href=\"#Step-8%3A-Review-the-Preview\">Step 8: Review the Preview</a></li><li><a href=\"#Step-9%3A-Click-%E2%80%9CSend-Gift-Card%E2%80%9D\">Step 9: Click \u201cSend Gift Card\u201d</a></li></ul></ul></li><li><a href=\"#Delivery-Methods-Explained\">Delivery Methods Explained</a><ul><ul><li><a href=\"#Email\">Email</a></li><li><a href=\"#SMS\">SMS</a></li><li><a href=\"#PDF-(via-Email)\">PDF (via Email)</a></li><li><a href=\"#QR-Code-(via-Email)\">QR Code (via Email)</a></li></ul></ul></li><li><a href=\"#Scheduling-Delivery\">Scheduling Delivery</a></li><li><a href=\"#What-Happens-After-a-Gift-Card-Is-Sent\">What Happens After a Gift Card Is Sent</a></li><li><a href=\"#Key-Behaviors-&amp;-Limitations\">Key Behaviors &amp; Limitations</a></li><li><a href=\"#FAQs\">FAQs</a></li></ul><hr data-start=\"1045\" data-end=\"1048\"><h1 data-end=\"1067\" data-start=\"1050\" id=\"Overview\"><strong data-end=\"1067\" data-start=\"1052\" dir=\"ltr\">Overview</strong></h1><p data-end=\"1328\" data-start=\"1068\">The <strong data-end=\"1080\" data-start=\"1072\">Send</strong> feature allows businesses to issue fully valid gift cards to customers instantly or on a schedule\u2014without taking any payment.</p><p data-end=\"1328\" data-start=\"1068\" dir=\"ltr\"><br data-start=\"1206\" data-end=\"1209\">Each card sent creates a <strong data-end=\"1253\" data-start=\"1234\">Gift Card Order</strong> and includes recipient information, expiry, balance, and delivery details.</p><p data-end=\"1354\" data-start=\"1330\" dir=\"ltr\"><br></p><p data-end=\"1354\" data-start=\"1330\" dir=\"ltr\">You can send gift cards:</p><ul data-end=\"1536\" data-start=\"1355\"><li data-end=\"1370\" data-start=\"1355\"><p data-end=\"1370\" data-start=\"1357\">As a reward</p></li><li data-end=\"1399\" data-start=\"1371\"><p data-end=\"1399\" data-start=\"1373\">As a gesture of goodwill</p></li><li data-end=\"1419\" data-start=\"1400\"><p data-end=\"1419\" data-start=\"1402\">As compensation</p></li><li data-end=\"1454\" data-start=\"1420\"><p data-end=\"1454\" data-start=\"1422\">For testing or debugging teams</p></li><li data-end=\"1489\" data-start=\"1455\"><p data-end=\"1489\" data-start=\"1457\">As part of internal promotions</p></li><li data-end=\"1536\" data-start=\"1490\"><p data-end=\"1536\" data-start=\"1492\">To influencers, partners, or VIP customers</p></li></ul><p data-end=\"1666\" data-start=\"1538\">Gift Cards sent through the Send flow function exactly like purchased gift cards\u2014they are redeemable at all supported checkouts.</p><hr data-start=\"1668\" data-end=\"1671\"><h1 data-end=\"1714\" data-start=\"1673\" id=\"Use-Cases-for-Sending-Gift-Cards\"><strong data-end=\"1714\" data-start=\"1675\" dir=\"ltr\">Use Cases for Sending Gift Cards</strong></h1><p data-end=\"1756\" data-start=\"1715\">Sending Gift Cards manually is ideal for:</p><h3 data-end=\"1785\" data-start=\"1758\" id=\"\u2b50-Loyalty-&amp;-Rewards\"><strong data-end=\"1785\" data-start=\"1762\">\u2b50 Loyalty &amp; Rewards</strong></h3><p data-end=\"1855\" data-start=\"1786\">Reward customers for milestones, referrals, or premium plan renewals.</p><h3 data-end=\"1896\" data-start=\"1857\" id=\"\u2b50-Customer-Support-Compensation\"><strong data-end=\"1896\" data-start=\"1861\">\u2b50 Customer Support Compensation</strong></h3><p data-end=\"1952\" data-start=\"1897\">Issue a gift card instead of a manual credit or refund.</p><h3 data-end=\"1974\" data-start=\"1954\" id=\"\u2b50-Promotions\"><strong data-end=\"1974\" data-start=\"1958\">\u2b50 Promotions</strong></h3><p data-end=\"2047\" data-start=\"1975\">Run giveaways, holiday gifting, influencer campaigns, or targeted perks.</p><h3 data-end=\"2075\" data-start=\"2049\" id=\"\u2b50-Internal-Testing\"><strong data-end=\"2075\" data-start=\"2053\">\u2b50 Internal Testing</strong></h3><p data-end=\"2134\" data-start=\"2076\">QA teams, admins, or developers can test redemption flows.</p><h3 data-end=\"2170\" data-start=\"2136\" id=\"\u2b50-Bulk-Manual-Distribution\"><strong data-end=\"2170\" data-start=\"2140\">\u2b50 Bulk Manual Distribution</strong></h3><p data-end=\"2227\" data-start=\"2171\">Gift VIP customers or event attendees a prepaid balance.</p><hr data-start=\"2229\" data-end=\"2232\"><h1 data-end=\"2256\" data-start=\"2234\" id=\"Prerequisites\"><strong data-end=\"2256\" data-start=\"2236\" dir=\"ltr\">Prerequisites</strong></h1><p data-end=\"2292\" data-start=\"2257\">Before sending a gift card, ensure:</p><ol data-end=\"2639\" data-start=\"2294\"><li data-end=\"2329\" data-start=\"2294\"><p data-end=\"2329\" data-start=\"2297\">A <strong data-end=\"2320\" data-start=\"2299\">Gift Card Product</strong> exists</p></li><li data-end=\"2400\" data-start=\"2330\"><p data-end=\"2400\" data-start=\"2333\" dir=\"ltr\">The Gift Card Product is <strong data-end=\"2368\" data-start=\"2358\">Active</strong> (not Deactivated or Archived)</p></li><li data-end=\"2639\" data-start=\"2522\"><p data-end=\"2562\" data-start=\"2525\" dir=\"ltr\">The customer receiving the card has either:</p><ul data-end=\"2639\" data-start=\"2566\"><li data-end=\"2594\" data-start=\"2566\"><p data-end=\"2594\" data-start=\"2568\">An <strong data-end=\"2588\" data-start=\"2571\">email address</strong>, or</p></li><li data-end=\"2639\" data-start=\"2598\"><p data-end=\"2639\" data-start=\"2600\">A <strong data-end=\"2618\" data-start=\"2602\">phone number</strong> (for SMS delivery)</p></li></ul></li></ol><hr data-start=\"2641\" data-end=\"2644\"><h1 data-end=\"2699\" data-start=\"2646\" id=\"How-to-Send-a-Gift-Card-(Step-by-Step-Guide)\"><strong data-end=\"2699\" data-start=\"2648\" dir=\"ltr\">How to Send a Gift Card (Step-by-Step Guide)</strong></h1><h3 data-end=\"2747\" data-start=\"2701\" id=\"Step-1:-Navigate-to-Gift-Card-Products\"><strong data-end=\"2747\" data-start=\"2705\">Step 1: Navigate to Gift Card Products</strong></h3><p data-end=\"2803\" data-start=\"2748\">Go to:<br data-start=\"2754\" data-end=\"2757\"><strong data-end=\"2803\" data-start=\"2757\">Payments \u2192 Gift Cards \u2192 Gift Card Products</strong></p><p data-end=\"2853\" data-start=\"2805\"><em data-end=\"2853\" data-start=\"2805\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058780577/original/K-hpS_mxRAutl4_WIzievGBCfzTuWpvkMQec50.png?1763571255\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058780577\"></em></p><hr data-start=\"2855\" data-end=\"2858\"><h3 data-end=\"2904\" data-start=\"2860\" id=\"Step-2:&nbsp;Click-\u201cSend\u201d\"><strong data-end=\"2904\" data-start=\"2864\">Step 2:&nbsp;</strong><strong data-end=\"3020\" data-start=\"2996\" dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\">Click \u201cSend\u201d</strong></h3><p data-end=\"2939\" data-start=\"2905\" dir=\"ltr\">On the product you want to send, <strong dir=\"ltr\">click the 'Send' CTA.&nbsp;</strong>You will now enter the Send flow.</p><p data-end=\"2939\" data-start=\"2905\" dir=\"ltr\"><strong dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058780631/original/mpUdc7A5xWMtM90AZP6WSQe3ROoTVeowfwafd0.png?1763571331\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058780631\"></strong><br></p><hr data-start=\"2987\" data-end=\"2990\"><h3 data-end=\"3020\" data-start=\"2992\" id=\"Step-3:&nbsp;Choose-a-Customer\"><strong data-end=\"3020\" data-start=\"2996\" dir=\"ltr\">Step 3:&nbsp;</strong><strong data-end=\"3179\" data-start=\"3151\" dir=\"ltr\">Choose a Customer</strong></h3><p data-end=\"3201\" data-start=\"3180\" dir=\"ltr\">Choose the recipient: Select an existing customer from your list</p><p data-end=\"3328\" data-start=\"3289\"><em data-end=\"3328\" data-start=\"3289\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058780801/original/3bd7nyTCqSrsTomX7wAfbXjfkqxTZtv9MQ7952.png?1763571416\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058780801\"></em></p><p><em data-end=\"3328\" data-start=\"3289\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058780806/original/TaElWoGikI48ZaJ4t5JWJntEudcp3if8lw977b.png?1763571423\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058780806\"></em></p><p><br></p><hr data-start=\"3330\" data-end=\"3333\"><h3 data-end=\"3542\" data-start=\"3493\" id=\"Step-4:-Add-a-Personal-Message\"><strong data-end=\"3542\" data-start=\"3497\" dir=\"ltr\">Step 4: Add a Personal Message</strong></h3><p data-end=\"3557\" data-start=\"3543\">You can enter:</p><ul data-end=\"3679\" data-start=\"3558\"><li data-end=\"3579\" data-start=\"3558\"><p data-end=\"3579\" data-start=\"3560\">A custom greeting<br><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058780977/original/tQkPDEJ0UCga7dwbhamrSSjyfhRgjwYkxw3963.png?1763571484\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058780977\"></p></li><li data-end=\"3604\" data-start=\"3580\"><p data-end=\"3604\" data-start=\"3582\">Special instructions</p></li><li data-end=\"3631\" data-start=\"3605\"><p data-end=\"3631\" data-start=\"3607\">A note of appreciation</p></li><li data-end=\"3631\" data-start=\"3605\"><p data-end=\"3631\" data-start=\"3607\" dir=\"ltr\">A message from the pre-populated messages</p></li></ul><hr data-start=\"3488\" data-end=\"3491\"><h3 data-end=\"3372\" data-start=\"3335\" id=\"Step-5:-Select-a-Denomination\"><strong data-end=\"3372\" data-start=\"3339\" dir=\"ltr\">Step 5: Select a Denomination</strong></h3><p data-end=\"3439\" data-start=\"3373\">Choose one of the preset denominations configured for the product.</p><p data-end=\"3486\" data-start=\"3441\"><em data-end=\"3486\" data-start=\"3441\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781031/original/E3zm-AUtjS4Om74CEBx_4Tl8ftB1M08Lww6db1.png?1763571509\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781031\"></em><br></p><hr data-start=\"3734\" data-end=\"3737\"><h3 data-end=\"3777\" data-start=\"3739\" id=\"Step-6:-Choose-Delivery-Method\"><strong data-end=\"3777\" data-start=\"3743\" dir=\"ltr\">Step 6: Choose Delivery Method</strong></h3><p data-end=\"3843\" data-start=\"3778\">You can deliver the gift card through any <em data-end=\"3825\" data-start=\"3820\">one</em> available method:</p><ul data-end=\"3922\" data-start=\"3845\"><li data-end=\"3858\" data-start=\"3845\"><p data-end=\"3858\" data-start=\"3847\"><strong data-end=\"3856\" data-start=\"3847\">Email</strong><br><strong data-end=\"3856\" data-start=\"3847\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781106/original/3d-Lmziw9E7phUyVJ07fDIEVY2w8pkVHhw4a6c.png?1763571639\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781106\"></strong></p></li><li data-end=\"3870\" data-start=\"3859\"><p data-end=\"3870\" data-start=\"3861\"><strong data-end=\"3868\" data-start=\"3861\">SMS</strong><br><strong data-end=\"3868\" data-start=\"3861\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781064/original/v0RncFUA5M7gXEnNVKvSrBhX-XPZINHP3Q2f03.png?1763571559\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781064\"></strong></p></li><li data-end=\"3898\" data-start=\"3871\"><p data-end=\"3898\" data-start=\"3873\"><strong data-end=\"3896\" data-start=\"3873\">QR Code (via email)</strong></p></li><li data-end=\"3922\" data-start=\"3899\"><p data-end=\"3922\" data-start=\"3901\"><strong data-end=\"3920\" data-start=\"3901\">PDF (via email)</strong></p></li></ul><p data-end=\"4016\" data-start=\"3924\" dir=\"ltr\">Only methods supported by the customer's available information (email/phone) will be enabled.</p><p data-end=\"4068\" data-start=\"4018\"><br></p><hr data-start=\"4070\" data-end=\"4073\"><h3 data-end=\"4111\" data-start=\"4075\" id=\"Step-7:-Choose-Delivery-Time\"><strong data-end=\"4111\" data-start=\"4079\" dir=\"ltr\">Step 7: Choose Delivery Time</strong></h3><p data-end=\"4127\" data-start=\"4112\">You can either:</p><ul data-end=\"4207\" data-start=\"4129\"><li data-end=\"4156\" data-start=\"4129\"><p data-end=\"4156\" data-start=\"4131\"><strong data-end=\"4154\" data-start=\"4131\">Deliver Immediately</strong></p></li><li data-end=\"4207\" data-start=\"4157\"><p data-end=\"4207\" data-start=\"4159\"><strong data-end=\"4205\" data-start=\"4159\">Schedule Delivery for a Future Date &amp; Time</strong><br><strong data-end=\"4205\" data-start=\"4159\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781203/original/eK2-YVkDqsVEjJLEj9bQUevvdrq79isNXg3d9b.png?1763571751\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781203\"></strong></p></li></ul><p data-end=\"4280\" data-start=\"4209\" dir=\"ltr\">Scheduled cards remain are sent on the scheduled date but if the code is accessed and used on any checkout, it can be redeemed before the scheduled date.</p><p data-end=\"4323\" data-start=\"4282\"><br></p><hr data-start=\"4325\" data-end=\"4328\"><h3 data-end=\"4364\" data-start=\"4330\" id=\"Step-8:-Review-the-Preview\"><strong data-end=\"4364\" data-start=\"4334\" dir=\"ltr\">Step 8: Review the Preview</strong></h3><p data-end=\"4440\" data-start=\"4365\">Before confirming, review the automatically generated email or SMS preview.</p><p data-end=\"4456\" data-start=\"4442\">This includes:</p><ul data-end=\"4552\" data-start=\"4457\"><li data-end=\"4477\" data-start=\"4457\"><p data-end=\"4477\" data-start=\"4459\">Gift card amount</p></li><li data-end=\"4496\" data-start=\"4478\"><p data-end=\"4496\" data-start=\"4480\">Custom message</p></li><li data-end=\"4512\" data-start=\"4497\"><p data-end=\"4512\" data-start=\"4499\">Expiry date</p></li><li data-end=\"4540\" data-start=\"4513\"><p data-end=\"4540\" data-start=\"4515\">Redemption instructions</p></li><li data-end=\"4552\" data-start=\"4541\"><p data-end=\"4552\" data-start=\"4543\">Artwork</p></li></ul><p data-end=\"4597\" data-start=\"4554\" dir=\"ltr\">Note: Preview is non-editable at this time.</p><p data-end=\"4637\" data-start=\"4599\"><br></p><hr data-start=\"4639\" data-end=\"4642\"><h3 data-end=\"4683\" data-start=\"4644\" id=\"Step-9:-Click-\u201cSend-Gift-Card\u201d\"><strong data-end=\"4683\" data-start=\"4648\" dir=\"ltr\">Step 9: Click \u201cSend Gift Card\u201d</strong></h3><p data-end=\"4764\" data-start=\"4684\">The system will immediately create a <strong data-end=\"4740\" data-start=\"4721\">Gift Card Order</strong> and queue the delivery.</p><hr data-start=\"4766\" data-end=\"4769\"><h1 data-end=\"4806\" data-start=\"4771\" id=\"Delivery-Methods-Explained\"><strong data-end=\"4806\" data-start=\"4773\" dir=\"ltr\">Delivery Methods Explained</strong></h1><h3 data-end=\"4824\" data-start=\"4808\" id=\"Email\"><strong data-end=\"4824\" data-start=\"4812\" dir=\"ltr\">Email</strong></h3><ul data-end=\"4944\" data-start=\"4825\"><li data-end=\"4863\" data-start=\"4825\"><p data-end=\"4863\" data-start=\"4827\">Full visual gift card with artwork</p></li><li data-end=\"4913\" data-start=\"4864\"><p data-end=\"4913\" data-start=\"4866\">Includes expiry, balance, and redemption link</p></li><li data-end=\"4944\" data-start=\"4914\"><p data-end=\"4944\" data-start=\"4916\">Recommended for most cases<br><br class=\"Apple-interchange-newline\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781303/original/WjPGO7euXUM9DieNoBYUZyfJZUod2HNgVg3a00.jpg?1763571890\" class=\"fr-fic fr-fil fr-dib\" data-id=\"155058781303\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; padding: 0px 1px; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 13px; font-weight: 400; text-indent: 0px; width: auto;\" data-attachment=\"[object Object]\"></p></li></ul><h3 data-end=\"4960\" data-start=\"4946\" id=\"SMS\"><strong data-end=\"4960\" data-start=\"4950\" dir=\"ltr\">SMS</strong></h3><ul data-end=\"5057\" data-start=\"4961\"><li data-end=\"5010\" data-start=\"4961\"><p data-end=\"5010\" data-start=\"4963\">Sends a clean message with the gift card link</p></li><li data-end=\"5057\" data-start=\"5011\"><p data-end=\"5057\" data-start=\"5013\">Artwork not included due to SMS formatting<br><em data-end=\"4637\" data-start=\"4599\" style=\"box-sizing: border-box; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 13px; font-weight: 400; text-align: left; text-indent: 0px;\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781312/original/DYY7u6GElLKYlQz6gDLUBd3quPIp6QsqvA7ee3.jpg?1763571903\" class=\"fr-fic fr-fil fr-dib\" data-id=\"155058781312\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; padding: 0px 1px; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; width: auto;\" data-attachment=\"[object Object]\"></em></p></li></ul><h3 data-end=\"5085\" data-start=\"5059\" id=\"PDF-(via-Email)\"><strong data-end=\"5085\" data-start=\"5063\" dir=\"ltr\">PDF (via Email)</strong></h3><ul data-end=\"5185\" data-start=\"5086\"><li data-end=\"5124\" data-start=\"5086\"><p data-end=\"5124\" data-start=\"5088\">Sends a downloadable printable PDF</p></li><li data-end=\"5185\" data-start=\"5125\"><p data-end=\"5185\" data-start=\"5127\" dir=\"ltr\">Great for in-store gifting, physical wrapping, or events<br><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781288/original/plZ4NoT8BX_eIfl0ziRwezksHnwkGViEege13b.jpg?1763571874\" class=\"fr-fic fr-fil fr-dib\" data-id=\"155058781288\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; padding: 0px 1px; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 13px; font-weight: 400; text-indent: 0px; width: auto;\" data-attachment=\"[object Object]\"></p></li></ul><h3 data-end=\"5217\" data-start=\"5187\" id=\"QR-Code-(via-Email)\"><strong data-end=\"5217\" data-start=\"5191\" dir=\"ltr\">QR Code (via Email)</strong></h3><ul data-end=\"5310\" data-start=\"5218\"><li data-end=\"5267\" data-start=\"5218\"><p data-end=\"5267\" data-start=\"5220\">Sends a scannable QR that opens the gift card</p></li><li data-end=\"5310\" data-start=\"5268\"><p data-end=\"5310\" data-start=\"5270\">Useful for in-person gifting or events<br><br class=\"Apple-interchange-newline\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781334/original/0VYhcjR9S_nNnANt4pERccNQsUqys31Sqg74cb.jpg?1763571918\" class=\"fr-fic fr-fil fr-dib\" data-id=\"155058781334\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; padding: 0px 1px; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: 13px; font-weight: 400; text-indent: 0px; width: auto;\" data-attachment=\"[object Object]\"></p></li></ul><hr data-start=\"5312\" data-end=\"5315\"><h1 data-end=\"5345\" data-start=\"5317\" id=\"Scheduling-Delivery\"><strong data-end=\"5345\" data-start=\"5319\" dir=\"ltr\">Scheduling Delivery</strong></h1><p data-end=\"5425\" data-start=\"5346\">You can choose a specific <strong data-end=\"5389\" data-start=\"5372\">date and time</strong> in the future.<br data-start=\"5404\" data-end=\"5407\">Until that moment:</p><ul data-end=\"5537\" data-start=\"5427\"><li data-end=\"5466\" data-start=\"5427\"><p data-end=\"5466\" data-start=\"5429\" dir=\"ltr\">The gift card remains <strong data-end=\"5464\" data-start=\"5451\" dir=\"ltr\">Scheduled&nbsp;</strong>but still active i.e. if there is an attempt to use the code on checkouts, it would work.</p></li><li data-end=\"5504\" data-start=\"5467\"><p data-end=\"5504\" data-start=\"5469\" dir=\"ltr\">It is visible in Gift Card Orders but with a 'Scheduled' tag</p></li></ul><p data-end=\"5565\" data-start=\"5539\">At the moment of delivery:</p><ul data-end=\"5639\" data-start=\"5566\"><li data-end=\"5597\" data-start=\"5566\"><p data-end=\"5597\" data-start=\"5568\" dir=\"ltr\">Gift card email/SMS is sent to the Customer</p></li></ul><p data-end=\"5700\" data-start=\"5641\">Perfect for birthdays, anniversaries, or campaign launches.</p><hr data-start=\"5702\" data-end=\"5705\"><h1 data-end=\"5754\" data-start=\"5707\" id=\"What-Happens-After-a-Gift-Card-Is-Sent\"><strong data-end=\"5754\" data-start=\"5709\" dir=\"ltr\">What Happens After a Gift Card Is Sent</strong></h1><p data-end=\"5795\" data-start=\"5756\">Once sent, the gift card appears under:</p><p data-end=\"5841\" data-start=\"5797\"><strong data-end=\"5841\" data-start=\"5797\">Payments \u2192 Gift Cards \u2192 Gift Card Orders</strong><br><strong data-end=\"5841\" data-start=\"5797\" dir=\"ltr\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781421/original/i3ooQZ67N0uDjNvKHlV0K2-bAhMXm4pZLA144e.png?1763572014\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781421\"></strong><br></p><p data-end=\"5876\" data-start=\"5843\" dir=\"ltr\">The Gift Card Order Details will contain:</p><ul data-end=\"6128\" data-start=\"5877\"><li data-end=\"5898\" data-start=\"5877\"><p data-end=\"5898\" data-start=\"5879\">Recipient details</p></li><li data-end=\"5918\" data-start=\"5899\"><p data-end=\"5918\" data-start=\"5901\">Delivery method</p></li><li data-end=\"5941\" data-start=\"5919\"><p data-end=\"5941\" data-start=\"5921\">Delivery timestamp</p></li><li data-end=\"5958\" data-start=\"5942\"><p data-end=\"5958\" data-start=\"5944\">Denomination</p></li><li data-end=\"5969\" data-start=\"5959\"><p data-end=\"5969\" data-start=\"5961\">Expiry</p></li><li data-end=\"5991\" data-start=\"5970\"><p data-end=\"5991\" data-start=\"5972\">Remaining balance</p></li><li data-end=\"6031\" data-start=\"5992\"><p data-end=\"6031\" data-start=\"5994\">Status: Scheduled, Active, Inactive</p></li><li data-end=\"6057\" data-start=\"6032\"><p data-end=\"6057\" data-start=\"6034\" dir=\"ltr\">Hidden gift card code<br><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781512/original/wSipxByD6Vb7ZvnPDhUJfi046MFnyBA0bA186c.png?1763572085\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781512\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155058781507/original/kj3ZutqGXD4w1peQBV2PngJ0hcGGSn46XA0652.png?1763572075\" style=\"width: auto; max-width: 100%;\" class=\"fr-fic fr-fil fr-dib\" data-attachment=\"[object Object]\" data-id=\"155058781507\"></p></li></ul><hr data-start=\"6178\" data-end=\"6181\"><h1 data-end=\"6219\" data-start=\"6183\" id=\"Key-Behaviors-&amp;-Limitations\"><strong data-end=\"6219\" data-start=\"6185\" dir=\"ltr\">Key Behaviors &amp; Limitations</strong></h1><ul data-end=\"6612\" data-start=\"6220\"><li data-end=\"6259\" data-start=\"6220\"><p data-end=\"6259\" data-start=\"6222\">Send flow works <strong data-end=\"6259\" data-start=\"6238\">only in Live Mode</strong></p></li><li data-end=\"6315\" data-start=\"6260\"><p data-end=\"6315\" data-start=\"6262\">You can send <strong data-end=\"6313\" data-start=\"6275\" dir=\"ltr\">1 gift card to 1 customer at a time</strong></p></li><li data-end=\"6360\" data-start=\"6316\"><p data-end=\"6360\" data-start=\"6318\">No payment is collected in the Send flow</p></li><li data-end=\"6445\" data-start=\"6361\"><p data-end=\"6445\" data-start=\"6363\" dir=\"ltr\">Directly sent gift cards <strong data-end=\"6405\" data-start=\"6388\">do not appear</strong> in Payments \u2192 Orders (no order, no transaction)</p></li><li data-end=\"6508\" data-start=\"6446\"><p data-end=\"6508\" data-start=\"6448\" dir=\"ltr\">Gift Cards issued via Send are fully redeemable everywhere - both fully and partially</p></li><li data-end=\"6564\" data-start=\"6509\"><p data-end=\"6564\" data-start=\"6511\" dir=\"ltr\">You must have the customer's email or phone number for delivery</p></li></ul><hr data-start=\"7052\" data-end=\"7055\"><h1 data-end=\"7071\" data-start=\"7057\" id=\"FAQs\"><strong data-end=\"7071\" data-start=\"7059\" dir=\"ltr\">FAQs</strong></h1><h3 data-end=\"7119\" data-start=\"7073\" id=\"Q:-Can-I-send-gift-cards-in-Test-Mode?\"><strong data-end=\"7119\" data-start=\"7077\">Q: Can I send gift cards in Test Mode?</strong></h3><p data-end=\"7217\" data-start=\"7120\" dir=\"ltr\">Not yet. Send flow supports <strong data-end=\"7166\" data-start=\"7148\">Live Mode only</strong>. Test Mode support is coming in future releases.</p><h3 data-end=\"7281\" data-start=\"7224\" id=\"\"><br></h3><h3 data-end=\"7281\" data-start=\"7224\" id=\"Q:-Why-can\u2019t-I-send-a-gift-card-to-some-customers?\"><strong data-end=\"7281\" data-start=\"7228\" dir=\"ltr\">Q: Why can\u2019t I send a gift card to some customers?</strong></h3><p data-end=\"7304\" data-start=\"7282\" dir=\"ltr\">The customer must have:</p><ul data-end=\"7351\" data-start=\"7305\"><li data-end=\"7326\" data-start=\"7305\"><p data-end=\"7326\" data-start=\"7307\">A valid email, or</p></li><li data-end=\"7351\" data-start=\"7327\"><p data-end=\"7351\" data-start=\"7329\">A valid phone number</p></li></ul><p data-end=\"7396\" data-start=\"7353\">Otherwise, no delivery method is available.</p><h3 data-end=\"7453\" data-start=\"7403\" id=\"-1\"><br></h3><h3 data-end=\"7453\" data-start=\"7403\" id=\"Q:-Can-I-send-multiple-gift-cards-at-once?\"><strong data-end=\"7453\" data-start=\"7407\">Q: Can I send multiple gift cards at once?</strong></h3><p data-end=\"7528\" data-start=\"7454\" dir=\"ltr\">Currently no. You can send <strong data-end=\"7513\" data-start=\"7481\" dir=\"ltr\">one gift card to one customer</strong> per Send flow. Bulk sending is planned for future versions.</p><h3 data-end=\"7634\" data-start=\"7581\" id=\"-2\"><br></h3><h3 data-end=\"7634\" data-start=\"7581\" id=\"Q:-Are-sent-gift-cards-redeemable-everywhere?\"><strong data-end=\"7634\" data-start=\"7585\">Q: Are sent gift cards redeemable everywhere?</strong></h3><p data-end=\"7705\" data-start=\"7635\">Yes \u2014 on every checkout that supports Gift Card redemption, including:</p><ul data-end=\"7814\" data-start=\"7706\"><li data-end=\"7717\" data-start=\"7706\"><p data-end=\"7717\" data-start=\"7708\">Funnels</p></li><li data-end=\"7727\" data-start=\"7718\"><p data-end=\"7727\" data-start=\"7720\">Forms</p></li><li data-end=\"7740\" data-start=\"7728\"><p data-end=\"7740\" data-start=\"7730\">Invoices</p></li><li data-end=\"7751\" data-start=\"7741\"><p data-end=\"7751\" data-start=\"7743\">Stores</p></li><li data-end=\"7769\" data-start=\"7752\"><p data-end=\"7769\" data-start=\"7754\">Payment Links</p></li><li data-end=\"7814\" data-start=\"7770\"><p data-end=\"7814\" data-start=\"7772\">Calendars (where products are supported)</p></li></ul><h3 data-end=\"7881\" data-start=\"7821\" id=\"-3\"><br></h3><h3 data-end=\"7881\" data-start=\"7821\" id=\"Q:-Can-I-edit-the-email/SMS-template-before-sending?\"><strong data-end=\"7881\" data-start=\"7825\">Q: Can I edit the email/SMS template before sending?</strong></h3><p data-end=\"8006\" data-start=\"7882\" dir=\"ltr\">Templates are system-generated and currently <strong data-end=\"7943\" data-start=\"7927\">not editable</strong>. Email &amp; SMS template customization will be available later.</p><h3 data-end=\"8075\" data-start=\"8013\" id=\"-4\"><br></h3><h3 data-end=\"8075\" data-start=\"8013\" id=\"Q:-Do-sent-gift-cards-appear-under-Orders-in-Payments?\"><strong data-end=\"8075\" data-start=\"8017\">Q: Do sent gift cards appear under Orders in Payments?</strong></h3><p data-end=\"8202\" data-start=\"8076\" dir=\"ltr\">No \u2014 only <strong data-end=\"8099\" data-start=\"8086\">purchased</strong> gift cards appear under Payments \u2192 Orders. Sent cards appear exclusively under <strong data-end=\"8201\" data-start=\"8181\">Gift Card Orders</strong>.</p><p data-end=\"8202\" data-start=\"8076\" dir=\"ltr\"><br></p><h3 data-end=\"4277\" data-start=\"4229\" id=\"Q:-Can-I-send-a-gift-card-anonymously?\"><strong data-end=\"4275\" data-start=\"4233\">Q: Can I send a gift card anonymously?</strong></h3><p data-end=\"4384\" data-start=\"4278\" dir=\"ltr\">Not yet. The recipient always sees the sender\u2019s business information as configured in email/SMS templates.</p><p data-end=\"4384\" data-start=\"4278\" dir=\"ltr\"><br></p>\n\t"}, {"slug": "155000005186-30033-us-a2p-10dlc-campaign-suspended", "title": "30033: US A2P 10DLC - Campaign Suspended", "folder": "Error Code and Warning Dictionary", "images": [], "videos": [], "content": "\n\t\t<div class=\"css-m8ey6p\" data-paste-core-version=\"21.0.1\" data-paste-element=\"BOX\" style=\"box-sizing: border-box; font-feature-settings: &quot;liga&quot; 0; display: flex; -webkit-box-pack: justify; justify-content: space-between; -webkit-box-ali