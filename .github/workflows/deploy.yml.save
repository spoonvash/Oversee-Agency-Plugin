name: Deploy to 20i Serve

on:
  push:
    branches:
      - Master

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.SSH_PRIVATE_KEY }}" | base64 -d > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -H ${{ secrets.SSH_HOST }} >> ~/.ssh/known_hosts

      - name: Deploy plugins to server
        run: |
          rsync -avz --delete \
            -e "ssh -i ~/.ssh/deploy_key" \
            ./oversee-helpdesk/oversee-helpdesk/ \
            ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}:/public_html/wp-content/plugins/oversee-helpdesk/
          
          rsync -avz --delete \
            -e "ssh -i ~/.ssh/deploy_key" \
            ./oversee-license-server/ \
            ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}:/public_html/wp-content/plugins/oversee-license-server/

      - name: Cleanup
        run: rm -f ~/.ssh/deploy_key   steps:
      - name: Checkout code
 : actions/checkout@v4

      - name Setup SSH
        run: 
          mkdi
          echo "${{ secrets.SSH_PVATE_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_k
          ssh-keyscan -H ${{ secrets.SSH_HOST }} >> ~/.ssh/known_hosts
      - name: Cleanup
        run: rm -f ~/.ssh/deploy_key

