ap: break-word;\"><a href=\"https://help.gohighlevel.com/a/solutions/articles/155000006834?portalId=48000045315#Spam\" style=\"box-sizing: border-box; color: rgb(44, 92, 197);\">Spam</a></li></ul></li><li style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a href=\"https://help.gohighlevel.com/a/solutions/articles/155000006834?portalId=48000045315#Engagement-Analysis-Chart\" style=\"box-sizing: border-box; color: rgb(44, 92, 197);\">Engagement Analysis Chart</a></li><li style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a href=\"https://help.gohighlevel.com/a/solutions/articles/155000006834?portalId=48000045315#Conversion-Summary-and-Analysis\" style=\"box-sizing: border-box; color: rgb(44, 92, 197);\">Conversion Summary and Analysis</a></li><li style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a href=\"https://help.gohighlevel.com/a/solutions/articles/155000006834?portalId=48000045315#Details-Tab-Overview\" style=\"box-sizing: border-box; color: rgb(44, 92, 197);\">Details Tab Overview</a></li><li style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a href=\"https://help.gohighlevel.com/a/solutions/articles/155000006834?portalId=48000045315#Frequently-Asked-Questions\" style=\"box-sizing: border-box; color: rgb(44, 92, 197);\">Frequently Asked Questions</a></li></ul><h2 data-end=\"1138\" data-start=\"1088\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 35px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.5em;\"><br><strong style=\"box-sizing: border-box; font-weight: 700;\">What is the Summary Page in Email Statistics?</strong></h2><p data-end=\"1351\" data-start=\"1140\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The <strong data-end=\"1160\" data-start=\"1144\" style=\"box-sizing: border-box; font-weight: 700;\">Summary Page</strong> gives you an at-a-glance view of your email campaign\u2019s performance. It includes engagement metrics like delivery, open, click, and bounce rates, as well as unsubscribe and spam statistics.</p><p data-end=\"1525\" data-start=\"1353\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">You can also view engagement trends over time, analyse conversions, and access detailed recipient-level data such as who opened, clicked, or unsubscribed from your email.</p><h2 data-end=\"1567\" data-start=\"1532\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 35px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.5em;\"><br><strong style=\"box-sizing: border-box; font-weight: 700;\">How to Access the Summary Page</strong></h2><ol data-end=\"1951\" data-start=\"1569\" style=\"box-sizing: border-box; margin-bottom: 4px; margin-left: 0px; padding: 0px 0px 0px 40px; line-height: 17px;\"><li data-end=\"1629\" data-start=\"1569\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1629\" data-start=\"1572\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Navigate to <strong data-end=\"1606\" data-start=\"1584\" style=\"box-sizing: border-box; font-weight: 700;\">Marketing \u2192 Emails</strong> from your dashboard.</p></li><li data-end=\"1663\" data-start=\"1630\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1663\" data-start=\"1633\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Go to the <strong data-end=\"1656\" data-start=\"1643\" style=\"box-sizing: border-box; font-weight: 700;\">Campaigns</strong> tab.<br style=\"box-sizing: border-box;\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057354615/original/ONsLF0HDZf4Mek3vDfwSEzKxnWuSjMY1cg74ca.jpg?1761974915\" class=\"fr-fil fr-dib inline-image\" data-id=\"155057354615\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; width: auto;\" data-attachment=\"[object Object]\"></p></li><li data-end=\"1705\" data-start=\"1664\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1705\" data-start=\"1667\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Locate your <strong data-end=\"1702\" data-start=\"1679\" style=\"box-sizing: border-box; font-weight: 700;\">sent email campaign</strong>.</p></li><li data-end=\"1773\" data-start=\"1706\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1773\" data-start=\"1709\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Click on the <strong data-end=\"1744\" data-start=\"1722\" style=\"box-sizing: border-box; font-weight: 700;\">three-dot menu (\u22ee)</strong> next to the campaign name.</p></li><li data-end=\"1803\" data-start=\"1774\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1803\" data-start=\"1777\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Select <strong data-end=\"1801\" data-start=\"1784\" dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\">\u201cStatistics.\u201d</strong><br style=\"box-sizing: border-box;\"><strong data-end=\"1801\" data-start=\"1784\" dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057354607/original/ziC3u9rxjtsn992I0r5uR6rYigZLEd0g6A72c5.jpg?1761974896\" class=\"fr-fil fr-dib inline-image\" data-id=\"155057354607\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; width: auto;\" data-attachment=\"[object Object]\"></strong></p></li><li data-end=\"1878\" data-start=\"1804\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1878\" data-start=\"1807\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">In the stats side panel that opens, click <strong data-end=\"1876\" data-start=\"1849\" style=\"box-sizing: border-box; font-weight: 700;\">\u201cLoad More Statistics.\u201d</strong><br style=\"box-sizing: border-box;\"><strong data-end=\"1876\" data-start=\"1849\" dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057354616/original/KGelzsiCcZpqLsKMVBQe3afnx_SeE3HX1w74ca.jpg?1761974915\" class=\"fr-fil fr-dib inline-image\" data-id=\"155057354616\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; width: auto;\" data-attachment=\"[object Object]\"></strong></p></li><li data-end=\"1951\" data-start=\"1879\" style=\"box-sizing: border-box; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><p data-end=\"1951\" data-start=\"1882\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">On the full statistics page, select the <strong data-end=\"1933\" data-start=\"1922\" style=\"box-sizing: border-box; font-weight: 700;\">Summary</strong> tab at the top.<br style=\"box-sizing: border-box;\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057354605/original/mm9haTXqf7KNO0eePOUXLzqpNnJV0xmWzQca2b.jpg?1761974887\" class=\"fr-fil fr-dib inline-image\" data-id=\"155057354605\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; width: auto;\" data-attachment=\"[object Object]\"></p></li></ol><h2 data-end=\"1992\" data-start=\"1958\" style=\"box-sizing: border-box; font-family: inherit; line-height: 35px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.5em;\"><br><strong>Understanding Summary Metrics<br style=\"box-sizing: border-box;\"></strong><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057354608/original/-36eg8zTevEyr_nW-IO0-r69S4ErpVdflQ06b6.jpg?1761974899\" class=\"fr-fil fr-dib inline-image\" data-id=\"155057354608\" style=\"box-sizing: border-box; border: 0px; max-width: 100%; cursor: pointer; margin-bottom: 5px; margin-left: 0px; display: block; text-align: left; padding: 0px 1px; color: rgb(0, 0, 0); font-family: Arial, Helvetica, sans-serif; font-size: 13px; font-weight: 400; text-indent: 0px; width: auto;\" data-attachment=\"[object Object]\"></h2><h3 data-end=\"2013\" data-start=\"1994\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"2011\" data-start=\"1998\" style=\"box-sizing: border-box; font-weight: 700;\">Delivered</strong></h3><p data-end=\"2122\" data-start=\"2014\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The percentage of emails that were successfully delivered to recipients\u2019 inboxes (out of all emails sent).</p><blockquote data-end=\"2170\" data-start=\"2123\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"2170\" data-start=\"2125\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"2137\" data-start=\"2125\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Formula:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;(Delivered / Total Sent) \u00d7 100</span></p></blockquote><p data-end=\"2259\" data-start=\"2172\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">A high delivery rate (90%+) indicates good sender reputation and clean contact lists.</p><h3 data-end=\"2282\" data-start=\"2266\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"2280\" data-start=\"2270\" style=\"box-sizing: border-box; font-weight: 700;\">Opened</strong></h3><p data-end=\"2350\" data-start=\"2283\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The percentage of recipients who opened your email at least once.</p><blockquote data-end=\"2400\" data-start=\"2351\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"2400\" data-start=\"2353\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"2365\" data-start=\"2353\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Formula:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;(Unique Opens / Delivered) \u00d7 100</span></p></blockquote><p data-end=\"2497\" data-start=\"2402\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">This helps measure how effective your subject line and sender name are at grabbing attention.</p><h3 data-end=\"2521\" data-start=\"2504\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"2519\" data-start=\"2508\" style=\"box-sizing: border-box; font-weight: 700;\">Clicked</strong></h3><p data-end=\"2597\" data-start=\"2522\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The percentage of recipients who clicked at least one link in your email.</p><blockquote data-end=\"2648\" data-start=\"2598\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"2648\" data-start=\"2600\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"2612\" data-start=\"2600\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Formula:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;(Unique Clicks / Delivered) \u00d7 100</span></p></blockquote><p data-end=\"2735\" data-start=\"2650\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">A higher click rate shows strong engagement and effective content or CTA placement.</p><h3 data-end=\"2762\" data-start=\"2742\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"2760\" data-start=\"2746\" style=\"box-sizing: border-box; font-weight: 700;\">Conversion</strong></h3><p data-end=\"2897\" data-start=\"2763\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The percentage of recipients who completed a desired action (like a purchase, booking, or signup) after clicking through your email.</p><blockquote data-end=\"2946\" data-start=\"2898\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"2946\" data-start=\"2900\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"2912\" data-start=\"2900\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Formula:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;(Conversions / Delivered) \u00d7 100</span></p></blockquote><p data-end=\"3035\" data-start=\"2948\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">If conversions are tracked, this metric helps evaluate campaign ROI and goal success.</p><h3 data-end=\"3064\" data-start=\"3042\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"3062\" data-start=\"3046\" style=\"box-sizing: border-box; font-weight: 700;\">Soft Bounced</strong></h3><p data-end=\"3170\" data-start=\"3065\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Emails that were temporarily undeliverable due to issues like a full inbox or temporary server problem.</p><blockquote data-end=\"3225\" data-start=\"3171\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"3225\" data-start=\"3173\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"3181\" data-start=\"3173\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Tip:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;These may still succeed if retried later.</span></p></blockquote><h3 data-end=\"3254\" data-start=\"3232\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"3252\" data-start=\"3236\" style=\"box-sizing: border-box; font-weight: 700;\">Hard Bounced</strong></h3><p data-end=\"3340\" data-start=\"3255\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">Emails that failed permanently, for example, invalid addresses or blocked domains.</p><blockquote data-end=\"3436\" data-start=\"3341\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"3436\" data-start=\"3343\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"3351\" data-start=\"3343\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Tip:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;Regularly clean your contact list to avoid high hard bounce rates (keep below 2%).</span></p></blockquote><h3 data-end=\"3465\" data-start=\"3443\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"3463\" data-start=\"3447\" style=\"box-sizing: border-box; font-weight: 700;\">Unsubscribed</strong></h3><p data-end=\"3539\" data-start=\"3466\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">The percentage of recipients who opted out using your unsubscribe link.</p><blockquote data-end=\"3589\" data-start=\"3540\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102);\"><p data-end=\"3589\" data-start=\"3542\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"3554\" data-start=\"3542\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Formula:</span></strong><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;(Unsubscribed / Delivered) \u00d7 100</span></p></blockquote><p data-end=\"3714\" data-start=\"3591\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word;\">A small unsubscribe rate (under 1%) is normal, but higher numbers may indicate irrelevant content or excessive frequency.</p><h3 data-end=\"3738\" data-start=\"3721\" style=\"box-sizing: border-box; font-family: inherit; font-weight: 400; line-height: 30.63px; color: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 1.17em;\"><strong data-end=\"3736\" data-start=\"3725\" style=\"box-sizing: border-box; font-weight: 700;\">Skipped</strong></h3><p class=\"p-rich_text_section\" dir=\"ltr\" style=\"box-sizing: inherit; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(29, 28, 29); font-family: Arial, Helvetica, sans-serif; font-weight: 400; text-align: left; text-indent: 0px;\"><span style=\"box-sizing: border-box; font-size: 13px; font-family: Arial, Helvetica, sans-serif;\">When the email is ready to go but skipped due to most likely</span></p><ul class=\"p-rich_text_list p-rich_text_list__bullet p-rich_text_list--nested\" data-border=\"0\" data-indent=\"0\" data-list-tree=\"true\" data-stringify-type=\"unordered-list\" style=\"box-sizing: inherit; margin-bottom: 0px; margin-left: 20px; padding: 0px; line-height: 17px; list-style: disc; margin-inline-start: 0px; padding-inline-start: 0px; color: rgb(29, 28, 29); font-family: Arial, Helvetica, sans-serif; font-size: 13px; font-weight: 400; text-align: left; text-indent: 0px;\"><li data-stringify-border=\"0\" data-stringify-indent=\"0\" style=\"box-sizing: inherit; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word; margin-inline-start: 28px;\"><span style=\"box-sizing: border-box; font-family: Arial, Helvetica, sans-serif;\"><span dir=\"ltr\" style=\"box-sizing: border-box; font-size: 13px;\">Any internal issue while sending the email to specific contact</span></span></li><li data-stringify-border=\"0\" data-stringify-indent=\"0\" dir=\"ltr\" style=\"box-sizing: inherit; font-size: 13px; line-height: 1.4; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word; margin-inline-start: 28px;\"><span style=\"box-sizing: border-box; font-size: 13px; font-family: Arial, Helvetica, sans-serif;\">If contact is dnd</span></li></ul><h3 data-end=\"3913\" data-start=\"3899