 0px; font-size: 1.5em; font-weight: 400; line-height: 35px !important;\"><strong style=\"box-sizing: border-box; font-weight: bold;\"><div class=\"image-container \" style=\"box-sizing: border-box; font-size: 13px; line-height: 18px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a class=\"image-enlarge-link\" href=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155026469917/original/_pTV6STA6UfUzczwkAPNx_e5LWHYDrWm5we784.png?1716452909\" style=\"box-sizing: border-box; color: rgb(51, 102, 187) !important; font-size: 16px !important; line-height: 20px !important;\" target=\"_blank\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155026474933/original/QWWuRoKkQSKuHrCt0JMYsJ5bjoILt25xdwd76d.png?1716456428\" class=\"fr-fic fr-fil fr-dib fr-bordered fr-shadow lightbox-image\" data-index=\"1\" style=\"box-sizing: content-box; max-width: 98%; border: 1px solid rgb(204, 204, 204); margin-bottom: 5px; margin-left: 0px; display: block; box-shadow: rgba(0, 0, 0, 0.12) 0px 1px 3px, rgba(0, 0, 0, 0.16) 0px 1px 1px 1px; width: 645px; height: 326.767px;\" data-attachment=\"[object Object]\" data-id=\"155026474933\"></a></div></strong><p style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 18px; word-break: normal; overflow-wrap: break-word; padding-top: 4px; color: rgb(24, 50, 71);\"><br style=\"box-sizing: border-box;\"></p><p style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 18px; word-break: normal; overflow-wrap: break-word; padding-top: 4px; color: rgb(24, 50, 71);\"><strong dir=\"ltr\" style=\"box-sizing: border-box; font-weight: bold;\"><br style=\"box-sizing: border-box;\"></strong></p><strong dir=\"ltr\" style=\"box-sizing: border-box; font-weight: bold;\">Leaderboard</strong></h2><p dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 1.5em; margin-left: 0px; font-size: 14px; line-height: 1.55em; word-break: normal; overflow-wrap: break-word; padding-top: 4px; color: rgb(88, 88, 88); font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\">Users can also view leaderboards for the group they are currently in to see how their levels stacks up against other members. This will give a preview of which courses unlock at certain levels as well as the custom level names for each group.<br style=\"box-sizing: border-box;\"><span dir=\"ltr\" style=\"box-sizing: border-box; font-size: 13px; line-height: 20px !important; color: rgb(29, 28, 29); font-family: Slack-Lato, Slack-Fractions, appleLogo, sans-serif; font-weight: 400; text-align: left; text-indent: 0px; display: inline !important;\">You can find members who earned the highest points in the past <strong dir=\"ltr\" style=\"box-sizing: border-box; font-weight: bold;\">7 days, 30 days, and overall.</strong></span><span style=\"box-sizing: border-box; font-size: 13px; line-height: 20px !important;\"><br style=\"box-sizing: border-box;\"></span></p><div class=\"image-container \" style=\"box-sizing: border-box; font-size: 13px; line-height: 18px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><a class=\"image-enlarge-link\" href=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155026472230/original/qNn-OvbdLnAMTFzMIFryEgs1hu-TIVQWngd91e.png?1716454411\" style=\"box-sizing: border-box; color: rgb(51, 102, 187) !important; font-size: 16px !important; line-height: 20px !important;\" target=\"_blank\"><img src=\"../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155026474936/original/spMBQMrp4IcUY2rl8ogY_5Ig9EFgJM9K9Qd76d.jpg?1716456428\" class=\"fr-fic fr-fil fr-dib lightbox-image\" data-id=\"155026474936\" style=\"box-sizing: border-box; max-width: 98%; margin-bottom: 5px; margin-left: 0px; display: block; width: 645px; height: 329.152px; border: 0px !important;\" data-attachment=\"[object Object]\"></a></div><div class=\"ql-block\" data-block-id=\"block-a8d0d245-0aa0-4c4f-9273-e4de3314af61\" dir=\"ltr\" style=\"box-sizing: border-box; font-size: 13px; line-height: 18px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\"><strong style=\"box-sizing: border-box; font-weight: bold;\"><br style=\"box-sizing: border-box;\"></strong></div><h2 class=\"ql-heading\" data-block-id=\"block-6ee78072-7027-4dfa-8218-fcc725d845d5\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 1.5em; line-height: 35px; font-weight: 400; font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif; color: rgb(0, 0, 0); text-align: left; text-indent: 0px;\"><strong dir=\"ltr\" style=\"box-sizing: border-box; font-weight: bold;\">Rewards</strong></h2><ul style=\"box-sizing: border-box; padding: 0px 0px 0px 40px; margin-bottom: 4px; margin-left: 0px; list-style: outside disc; line-height: 17px; font-size: 16px !important;\"><li dir=\"ltr\" style=\"box-sizing: border-box; line-height: 18px; font-size: 13px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\">Rewards - Group admins/ owners can choose to add offline rewards as texts. Maximum 3 rewards can be added. Example - Win $50 after reaching level 5.&nbsp;</li><li dir=\"ltr\" style=\"box-sizing: border-box; line-height: 18px; font-size: 13px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\">To add a reward (as an admin), go to Settings &gt; Gamification &amp; Rewards &gt; Rewards.</li><li dir=\"ltr\" style=\"box-sizing: border-box; line-height: 18px; font-size: 13px; margin-bottom: 0px; margin-left: 0px; word-break: normal; overflow-wrap: break-word;\">Once Rewards are added, they are reflected on the left nav ba