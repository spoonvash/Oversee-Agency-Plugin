weight: var(--editor-heading-font-weight, var(--cu-heading-weight)); font-stretch: inherit; font-size: calc(var(--editor-font-size) * 1.5); line-height: var(--editor-line-height); font-family: var(--editor-font-family); font-optical-sizing: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; cursor: text; counter-reset: list-0 0; hyphens: auto; transition: font-size 0.2s ease-out 0s, line-height 0.2s ease-out 0s, opacity 0.1s ease 0s, max-width 0.2s cubic-bezier(0.785, 0.135, 0.15, 0.86) 0s; width: 720px; max-width: var(--editor-max-width); text-align: left; text-indent: 0px;\"><br></h2><h2 data-block-id=\"block-706c7596-41ab-4826-9900-9026ddc630ba\" id=\"Google-Tag-Manager\" style=\"box-sizing: border-box; color: rgb(52, 52, 52); padding: 0px; border: 0px; font-weight: var(--editor-heading-font-weight, var(--cu-heading-weight)); font-stretch: inherit; font-size: calc(var(--editor-font-size) * 1.5); line-height: var(--editor-line-height); font-family: var(--editor-font-family); font-optical-sizing: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; cursor: text; counter-reset: list-0 0; hyphens: auto; transition: font-size 0.2s ease-out 0s, line-height 0.2s ease-out 0s, opacity 0.1s ease 0s, max-width 0.2s cubic-bezier(0.785, 0.135, 0.15, 0.86) 0s; width: 720px; max-width: var(--editor-max-width); text-align: left; text-indent: 0px;\"><strong><span dir=\"ltr\" style=\"font-size: 16px;\">Google Tag Manager</span></strong></h2><p><br></p><div><pre contenteditable=\"false\" data-code-brush=\"JavaScript\" rel=\"highlighter\">&lt;!-- Google Tag Manager --&gt;\n&lt;script&gt;\n  window.dataLayer = window.dataLayer || [];\n  function gtag() {\n    dataLayer.push(arguments);\n  }\n\n  gtag(\"consent\", \"default\", {\n    ad_storage: \"denied\",\n    ad_user_data: \"denied\",\n    ad_personalization: \"denied\",\n    analytics_storage: \"denied\",\n  });\n  window.addEventListener(\n    \"LCCookieConsentDoneGTM\",\n    function (cookieConsent) {\n      if (cookieConsent.detail.gtm === 'grant'){\n        gtag(\"consent\", \"update\", {\n          ad_storage: \"granted\",\n          ad_user_data: \"granted\",\n          ad_personalization: \"granted\",\n          analytics_storage: \"granted\",\n        });\n      }\n    },\n    !1\n  );\n&lt;/script&gt;\n&lt;script&gt;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&amp;l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-XXXXXX');&lt;/script&gt;\n&lt;!-- End Google Tag Manager --&gt;</pre></div><p><a class=\"cu-table-content__anchor\" style=\"box-sizing: border-box; color: rgb(74, 144, 226); margin-bottom: 0px; margin-left: auto; padding: 0px; border: 0px; font-weight: 400; font-stretch: inherit; font-size: 16px; line-height: var(--editor-line-height); font-family: var(--editor-font-family); font-optical-sizing: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; cursor: text; display: block; top: -75px; visibility: hidden; hyphens: auto; word-break: break-all; width: 720px; max-width: var(--editor-max-width); transition: font-size 0.2s ease-out 0s, line-height 0.2s ease-out 0s, opacity 0.1s ease 0s, max-width 0.2s cubic-bezier(0.785, 0.135, 0.15, 0.86) 0s; text-align: left; text-indent: 0px;\"></a></p><h3 dir=\"ltr\" id=\"-2\" style=\"line-height: 1.38; margin-bottom: 4pt;\"><br></h3><h3 dir=\"ltr\" id=\"Reading-Cookie-CategoriesThe-below-code-is-optional-if-you-wish-to-read-consent-or-categories-user-has-accepted-for-other-custom-code-or-third-party-javascript\" style=\"line-height: 1.38; margin-bottom: 4pt;\"><span style=\"font-size: 13pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-weight: 700;\">Reading Cookie Categories<br><br></span><span dir=\"ltr\" style=\"font-size: 13pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\">The below code is optional if you wish to read consent or categories user has accepted for other custom code or third party javascript</span></h3><p><br></p><div><pre contenteditable=\"false\" data-code-brush=\"JavaScript\" rel=\"highlighter\">// Helper function to get consented categories\nfunction getConsentedCategories() {\n  const categoriesCookie = document.cookie\n    .split('; ')\n    .find(row =&gt; row.startsWith('cookie-categories='));\n  \n  if (categoriesCookie) {\n    // Convert cookie value to array\n    return categoriesCookie.split('=')[1].split(',');\n  }\n  return [];\n}\n\n// Helper function to check if category is allowed\nfunction isCategoryAllowed(category) {\n  const categories = getConsentedCategories();\n  return categories.includes(category);\n}\n\n// Helper function to get cookie config\nfunction getCookieConfig() {\n  const cookieConfig = document.cookie\n    .split('; ')\n    .find(row =&gt; row.startsWith('cookie-config='));\n    \n  if (cookieConfig) {\n    return cookieConfig.split('=')[1]; // Returns: all, essential, or custom\n  }\n  return undefined; // Return undefined if user hasn't made a choice yet\n}</pre><h3 dir=\"ltr\" id=\"-3\" style=\"line-height: 1.38; margin-bottom: 4pt;\"><br></h3><h3 dir=\"ltr\" id=\"Important-Notes:\" style=\"line-height: 1.38; margin-bottom: 4pt;\"><span style=\"font-size: 13pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 700;\">Important Notes:</span></h3><ol style=\"margin-bottom: 0px; padding-inline-start: 48px;\"><li dir=\"ltr\" style=\"list-style-type: decimal; font-size: 11pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\"><p dir=\"ltr\" style=\"line-height: 1.38; margin-bottom: 0pt;\"><span style=\"font-family: Helvetica,sans-serif;\"><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">The cookie categories are stored in the&nbsp;</span><span style=\"font-size: 11pt; color: rgb(24, 128, 56); font-weight: 400;\">cookie-categories</span><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">&nbsp;cookie</span></span></p></li><li dir=\"ltr\" style=\"list-style-type: decimal; font-size: 11pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\"><p dir=\"ltr\" style=\"line-height: 1.38; margin-bottom: 0pt;\"><span style=\"font-family: Helvetica,sans-serif;\"><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">Categories are comma-separated (e.g., \"essential,advertising,analytics\")</span></span></p></li><li dir=\"ltr\" style=\"list-style-type: decimal; font-size: 11pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\"><p dir=\"ltr\" style=\"line-height: 1.38; margin-bottom: 0pt;\"><span style=\"font-family: Helvetica,sans-serif;\"><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">Always check for initial consent when loading your marketing tools</span></span></p></li><li dir=\"ltr\" style=\"list-style-type: decimal; font-size: 11pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\"><p dir=\"ltr\" style=\"line-height: 1.38; margin-bottom: 0pt;\"><span style=\"font-family: Helvetica,sans-serif;\"><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">Listen for consent change events to update tool settings</span></span></p></li><li dir=\"ltr\" style=\"list-style-type: decimal; font-size: 11pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\"><p dir=\"ltr\" style=\"line-height: 1.38; margin-bottom: 12pt;\"><span style=\"font-family: Helvetica,sans-serif;\"><span style=\"font-size: 11pt; color: rgb(0, 0, 0); font-weight: 400;\">Remove any&nbsp;</span><span style=\"font-size: 11pt; color: rgb(24, 128, 56); font-weight: 400;\">&lt;noscript&gt;</span></span><span dir=\"ltr\" style=\"font-size: 11pt; font-family: Helvetica, sans-serif; color: rgb(0, 0, 0); font-weight: 400;\">&nbsp;tags as they may bypass consent checks</span></p></li></ol></div>\n\t"}, {"slug": "155000006843-image-element-in-email-builder", "title": "Image Element in Email Builder", "folder": "Email Builder Capabilities", "images": ["../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057289494/original/FJOmvw7ZFbokKI4kkmcYP8FYKElC9D1ZMw3ca9.png?1761904349", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057289695/original/5ULMgMtX99lLYUsvgAXpihAZikng-Fv51gaec0.png?1761904443", "../../../../s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/155057289798/original/ad6WgCPPL4DGdz-JTuhgaSNG-_ao81_g3gf9cf.png?1761904510"], "videos": [], "content": "\n\t\t<p data-end=\"542\" data-start=\"211\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(24, 50, 71); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\">The Image Element in Email Builder allows you to easily add and customise images within your email templates. With support for multiple image sources, sizing options, and alignment controls, this element helps you create visually engaging and professional-looking emails that capture attention and improve engagement.</p><p class=\"fd-toc\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(24, 50, 71); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\"><br></p><p class=\"fd-toc\"><strong>TABLE OF CONTENTS</strong></p><ul><li><a href=\"#What-is-the-Image-Element-in-the-Email-Builder?\">What is the Image Element in the Email Builder?</a></li><li><a href=\"#Key-Benefits-of-the-Image-Element\">Key Benefits of the Image Element</a></li><li><a href=\"#How-To-Setup-the-Image-Element\">How To Setup the Image Element</a></li><li><a href=\"#Frequently-Asked-Questions\">Frequently Asked Questions</a></li></ul><h2 data-end=\"825\" data-start=\"767\" dir=\"ltr\" id=\"What-is-the-Image-Element-in-the-Email-Builder?\" style=\"box-sizing: border-box; font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; line-height: 35px; color: rgb(24, 50, 71); margin-bottom: 0px; margin-left: 0px; font-size: 1.5em; text-align: start; text-indent: 0px;\"><br><strong dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\">What is the Image Element in the Email Builder?</strong></h2><p data-end=\"1039\" data-start=\"827\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(24, 50, 71); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\">The Image Element is a drag-and-drop block in Email Builder that lets you insert images directly into your email layout. You can upload new images, use URLs, or pull from your existing file library.<br style=\"box-sizing: border-box;\"><br style=\"box-sizing: border-box;\"></p><p data-end=\"1300\" data-start=\"1041\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(24, 50, 71); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\">It supports customization options such as resizing, alignment, and linking, allowing you to use images for branding, product showcases, or visual storytelling. The element ensures that your images render correctly across all major email clients and devices.</p><blockquote data-end=\"1435\" data-start=\"1302\" style=\"box-sizing: border-box; padding: 6px 6px 1px 1em; margin-bottom: 0.5em; margin-left: 0.5em; font-size: 13px; border-left: 1px dotted rgb(153, 153, 153); line-height: 22px; color: rgb(102, 102, 102); font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; text-align: start; text-indent: 0px;\"><p data-end=\"1435\" data-start=\"1304\" dir=\"ltr\" style=\"box-sizing: border-box; margin-bottom: 0px; margin-left: 0px; font-size: 13px; line-height: 1.4; word-break: normal; overflow-wrap: break-word; color: rgb(41, 105, 176);\"><strong data-end=\"1313\" data-start=\"1304\" dir=\"ltr\" style=\"box-sizing: border-box; font-weight: 700;\"><span style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">Note:</span></strong><span dir=\"ltr\" style=\"box-sizing: border-box; color: rgb(41, 105, 176);\">&nbsp;To optimise load times and maintain email deliverability, use compressed images (under 1MB) in formats like JPG or PNG.</span></p></blockquote><h2 data-end=\"1421\" data-start=\"1383\" id=\"Key-Benefits-of-the-Image-Element\" style=\"box-sizing: border-box; font-family: -apple-system, &quot;system-ui&quot;, &quot;Segoe UI&quot;, Roboto, Arial, &quot;Helvetica Neue&quot;, sans-serif; font-weight: 400; line-height: 35px; color: rgb(24, 50, 71); margin-bottom: 0px; margin-left: 0px; font-size: 1.5em; text-align: start; text-indent: 0px;\"><br><strong style=\"box-sizing: border-box; font-weight: 700;\">Key Benefits of the Image Element</strong></h2><p data-end=\"1501\" data-start=\"1423\" style=